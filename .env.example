# Optional SQLAlchemy connection string. SQLite is the local default.
DATABASE_URL=sqlite:///./aeroopt.db
# Frontend API URL (create frontend/.env locally if overriding)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional API bearer-token RBAC. Use a secret manager in production.
# Example: {"replace-with-admin-secret":"admin","replace-with-planner-secret":"planner","replace-with-viewer-secret":"viewer"}
AEROOPT_AUTH_TOKENS=
APP_ENV=development
